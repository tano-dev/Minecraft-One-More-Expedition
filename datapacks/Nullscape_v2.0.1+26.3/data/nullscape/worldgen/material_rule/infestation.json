{
  "type": "minecraft:condition",
  "if_true": "nullscape:is_biome/infestation",
  "then_run": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:stone_depth",
      "offset": 5,
      "surface_type": "floor",
      "add_surface_depth": false,
      "secondary_depth_range": 1
    },
    "then_run": {
      "type": "minecraft:sequence",
      "sequence": [
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:noise_threshold",
            "max_threshold": 0.08,
            "min_threshold": -0.08,
            "noise": "nullscape:infestation/warped_wart"
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": {
              "id": "minecraft:warped_wart_block"
            }
          }
        },
        {
          "type": "minecraft:block",
          "result_state": {
            "id": "minecraft:sculk"
          }
        }
      ]
    }
  }
}
