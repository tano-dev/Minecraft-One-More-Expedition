// ### THE MOD REQUIRES A RESTART OF THE GAME TO APPLY CHANGES ###
{
  // Global spread factor: 2 keeps overworld surface structures nicely spaced.
  // Underground sets below override this with lower (denser) factors.
  "spreadFactor": 1.8,

  // Gives each structure_set its own salt to prevent overlapping placement patterns.
  "idBasedSalt": true,

  // Per-structure overrides.
  // Surface giants kept at 2 (or higher). Underground sets use < 1 to be denser than vanilla.
  "customSpreadFactors": [

    // ── Surface structures – keep rare / well-spaced ─────────────────────────
    { "structure": "minecraft:mansion",           "factor": 1   },

    // ── Vanilla underground – denser than global x2 ──────────────────────────
    { "structure": "minecraft:mineshafts",        "factor": 0.6 },
    { "structure": "minecraft:ancient_cities",    "factor": 0.8 },
    { "structure": "minecraft:trial_chambers",    "factor": 0.7 },
    { "structure": "minecraft:dungeons",          "factor": 0.5 },

    // ── Hopo Better Mineshaft ─────────────────────────────────────────────────
    { "structure": "hopo:mineshafts",             "factor": 0.6 },

    // ── Decubed Dungeons ──────────────────────────────────────────────────────
    { "structure": "decubed_dungeons:dungeons",   "factor": 0.65 },

    // ── DDD Dungeons ──────────────────────────────────────────────────────────
    { "structure": "ddd:dddungeons",              "factor": 0.7  },

    // ── Nova Structures (underground sets) ───────────────────────────────────
    { "structure": "nova_structures:small_cave_structures",    "factor": 0.5  },
    { "structure": "nova_structures:small_overworld_dungeons", "factor": 0.65 },
    { "structure": "nova_structures:crypts",                   "factor": 0.7  },
    { "structure": "nova_structures:special_mineshafts",       "factor": 0.6  },

    // ── Epic Structures (underground sets) ───────────────────────────────────
    { "structure": "epic:small_dungeons",         "factor": 0.65 },
    { "structure": "epic:medium_dungeons",        "factor": 0.7  },
    { "structure": "epic:large_dungeons",         "factor": 0.8  },

    // ── ATI Structures (underground sets) ────────────────────────────────────
    { "structure": "ati_structures:underground_small",  "factor": 0.6  },
    { "structure": "ati_structures:underground_medium", "factor": 0.65 },

    // ── Terralith underground ─────────────────────────────────────────────────
    { "structure": "terralith:underground",         "factor": 0.6  },
    { "structure": "terralith:underground_dungeon", "factor": 0.65 },
    { "structure": "terralith:rare_dungeon",        "factor": 0.75 },

    // ── Wabi Sabi Structures (cave) ───────────────────────────────────────────
    { "structure": "wabi_sabi_structures:birch_mushroom_cave", "factor": 0.65 },
    { "structure": "wabi_sabi_structures:spider_cellar",       "factor": 0.65 }
  ]
}
